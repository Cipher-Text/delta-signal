# Used by local dev commands: pnpm db:migrate, pnpm db:push, pnpm dev, etc.
DATABASE_URL="postgresql://delta_signal:delta_signal@localhost:5432/delta_signal?schema=public"

# Used by the API Docker container (docker-compose up).
# Same as DATABASE_URL but with host.docker.internal instead of localhost —
# inside the container, localhost resolves to the container itself, not the host.
DOCKER_DATABASE_URL="postgresql://delta_signal:delta_signal@host.docker.internal:5432/delta_signal?schema=public"

REDIS_URL="redis://localhost:6379"

# Required. The API refuses to start without this, and rejects placeholder
# values or anything under 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

PORT=3001

# Required in production. Comma-separated list of allowed CORS origins.
# The API will refuse to start in production if this is not set.
# Example: "https://deltasignal.org,https://admin.deltasignal.org"
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

NODE_ENV="development"

# ─── Production admin bootstrap (one-time) ────────────────────────────────────
# Set these only on your FIRST production deploy to create the initial admin
# account. Once the account exists, remove both vars from your deployment env.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-strong-password

# ─── Frontend URL (used in auth emails) ──────────────────────────────────────
# Base URL of the web app. Used to construct password-reset and email-verification
# links in outbound emails. Required in production — the API refuses to start
# without it when NODE_ENV=production. Defaults to http://localhost:3000 in dev.
APP_URL="http://localhost:3000"
# Production example: APP_URL=https://deltasignal.org

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Both vars must be set together — one without the other is a misconfiguration.
# To obtain credentials:
#   1. https://console.cloud.google.com/  → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Web application)
#   3. Add http://localhost:3001/api/v1/auth/google/callback to Authorised redirect URIs
#   4. For production, add your real domain instead of localhost
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Callback URL registered with Google (must match exactly):
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Production: GOOGLE_CALLBACK_URL=https://api.deltasignal.org/api/v1/auth/google/callback

# ─── File Storage — MinIO / S3 (optional) ────────────────────────────────────
# When STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY are not set the API starts
# normally but POST /media/upload and POST /media/presign return 503.
#
# MinIO (local / self-hosted):
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=delta-signal
STORAGE_REGION=us-east-1
# Path-style URLs are required for MinIO. Set to false for AWS S3.
STORAGE_USE_PATH_STYLE=true
# Optional: public-facing base URL for uploaded objects (e.g. behind a CDN).
# Defaults to ${STORAGE_ENDPOINT}/${STORAGE_BUCKET}.
# STORAGE_PUBLIC_URL=https://cdn.deltasignal.org
#
# AWS S3 (production):
# Omit STORAGE_ENDPOINT and STORAGE_USE_PATH_STYLE for AWS.
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# STORAGE_BUCKET=delta-signal-prod
# STORAGE_REGION=ap-southeast-1
# STORAGE_PUBLIC_URL=https://delta-signal-prod.s3.ap-southeast-1.amazonaws.com

# ─── Email ────────────────────────────────────────────────────────────────────
# Three independent mail transports are available — MAIL_PROVIDER picks which
# one is active ("smtp" | "mailgun" | "ses"). Defaults to smtp. All three
# degrade gracefully: if the selected provider's own vars are missing, the API
# starts normally but email delivery is silently disabled (alert notifications
# and auth emails are skipped, not errored).
#
# *_FROM vars below are only a fallback — EmailService hardcodes the actual
# sender per email type (noreply@deltasignal.org for verification/password
# reset, alerts@deltasignal.org for alert notifications), so recipients see a
# consistent sender no matter which provider is active.
MAIL_PROVIDER=smtp

# ── SMTP transport (used when MAIL_PROVIDER=smtp) ─────────────────────────────
#
# Local dev (MailPit): docker compose up -d mailpit
#   → SMTP on :1025, web inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Delta Signal <alerts@deltasignal.org>"
#
# Production (any SMTP provider):
# Gmail:      SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   (use App Password, not account password)
# Outlook365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# SendGrid:   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<api-key>
# Postmark:   SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587
# Custom:     SMTP_HOST=mail.yourdomain.com  SMTP_PORT=587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=your-password-or-api-key
# SMTP_FROM="Delta Signal <alerts@yourdomain.com>"

# ── Mailgun transport (used when MAIL_PROVIDER=mailgun) ───────────────────────
# Sends via the Mailgun HTTP API (not SMTP relay). Get the API key and domain
# from https://app.mailgun.com/ → Sending → Domains.
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_FROM="Delta Signal <alerts@mg.yourdomain.com>"
# EU-region Mailgun accounts only — omit for US:
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# ── AWS SES transport (used when MAIL_PROVIDER=ses) ───────────────────────────
# Requires the sending identity (domain or address) to be verified in SES, and
# the account to be out of the SES sandbox to send to unverified recipients.
# SES_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# SES_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# SES_REGION=us-east-1
# SES_FROM="Delta Signal <alerts@yourdomain.com>"

