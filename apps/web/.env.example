API_URL="http://localhost:3001"

# ─── Site URL (used to build robots.txt / sitemap.xml absolute URLs) ──────────
# Production example: NEXT_PUBLIC_SITE_URL=https://deltasignal.org
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Google Analytics (optional) ───────────────────────────────────────────────
# GA4 measurement ID from https://analytics.google.com/ → Admin → Data Streams.
# When unset, no gtag script is injected at all (not just disabled — absent).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Search Console (optional) ──────────────────────────────────────────
# HTML tag verification method — copy the content="..." value Search Console
# gives you (Settings → Ownership verification → HTML tag), not the full tag.
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Microsoft Clarity (optional) ──────────────────────────────────────────────
# Project ID from https://clarity.microsoft.com/ → Settings → Setup → project ID.
# When unset, no Clarity script is injected at all.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# ─── Seed login panel (development only) ──────────────────────────────────────
# Set NEXT_PUBLIC_ENABLE_SEED_LOGIN=true to show the one-click seed account panel
# on the login page. MUST be false (or unset) in production.
# Also set NEXT_PUBLIC_SEED_PASSWORD to the seed account password — this must
# never be hardcoded in source; leaving it unset in production means the hidden
# password field is empty and the panel cannot log in even if accidentally shown.
NEXT_PUBLIC_ENABLE_SEED_LOGIN="false"
# NEXT_PUBLIC_SEED_PASSWORD="NatureGrid123!"
