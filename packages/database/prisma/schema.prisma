  UNKNOWN
}

enum CompanyType {
  PRIVATE
  STATE_OWNED
  JOINT_VENTURE
  MULTINATIONAL
  CONGLOMERATE
  CLUSTER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
