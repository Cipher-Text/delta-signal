}

enum MeasurementParameter {
  // Water quality
  PH
  DISSOLVED_OXYGEN
  WATER_TEMPERATURE
  TURBIDITY
  CONDUCTIVITY
  SALINITY
  NITRATE_N
  PHOSPHATE_P
  BOD
  COD
  TOTAL_DISSOLVED_SOLIDS
  TOTAL_SUSPENDED_SOLIDS
  ARSENIC
  FECAL_COLIFORM
  WATER_DEPTH
  FLOW_VELOCITY
  // Air quality
  PM25
  PM10
  CO2
  CO
  NOX
  SOX
  OZONE
  VOC
  AQI
  AMBIENT_TEMPERATURE
  RELATIVE_HUMIDITY
  // Biodiversity / habitat
  SPECIES_COUNT
  INDIVIDUAL_COUNT
  CANOPY_COVER
  VEGETATION_DENSITY
  // Soil / land
  SOIL_PH
  SOIL_MOISTURE
  AREA_AFFECTED
  OTHER
}

enum MeasurementUnit {
  MG_PER_L          // mg/L  — dissolved substances in water
  UG_PER_L          // µg/L  — trace metals, arsenic
  NTU               // turbidity
  US_PER_CM         // µS/cm — conductivity
  PPT               // parts per thousand — salinity
  PH_UNITS          // dimensionless pH scale
  CELSIUS           // °C — temperature
  PPM               // parts per million
  PPB               // parts per billion
  UG_PER_M3         // µg/m³ — air particulates
  PERCENT           // %
  COUNT             // individual or species count
  METERS            // depth or distance
  METERS_PER_SECOND // flow velocity
  CFU_PER_100ML     // colony-forming units — fecal coliform
  HECTARES          // area affected
  INDEX             // dimensionless index (AQI)
  OTHER
}

enum QualityFlag {
  GOOD      // validated, reliable reading
  SUSPECT   // needs verification
  BAD       // likely erroneous
  ESTIMATED // interpolated or modelled
}

enum NotificationChannel {
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  displayName     String
  passwordHash    String?
  googleId        String?      @unique
  authProvider    AuthProvider @default(EMAIL)
  role            UserRole     @default(CITIZEN)
  isActive        Boolean      @default(true)
  isEmailVerified Boolean      @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reports                    CitizenReport[]
  observations               Observation[]
  auditEvents                AuditEvent[]
  refreshTokens              RefreshToken[]
  restorationProjectsCreated RestorationProject[]
  restorationParticipations  RestorationParticipant[]
  datasetAccessRequests      DatasetAccessRequest[]   @relation("DatasetAccessRequester")
  datasetAccessDecisions     DatasetAccessRequest[]   @relation("DatasetAccessDecider")
  alertSubscriptions         AlertSubscription[]
  notificationDeliveries     NotificationDelivery[]
  reportComments             ReportComment[]
  reportMedia                ReportMedia[]
  organizationMemberships    OrganizationMembership[]
  profile                    UserProfile?
  socialLinks                UserSocialLink[]
  recordedActivities         ProjectActivity[]
  measuredMetrics            ProjectMetric[]
  publishedDatasetVersions   DatasetVersion[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  oauthExchangeCodes         OAuthExchangeCode[]
  communityPosts             CommunityPost[]
  postComments               PostComment[]
  pollVotes                  PollVote[]
  socialDraftsCreated        SocialPostDraft[]       @relation("SocialDraftCreator")
  socialDraftsUpdated        SocialPostDraft[]       @relation("SocialDraftUpdater")
  socialDraftsApproved       SocialPostDraft[]       @relation("SocialDraftApprover")
  socialPlatformAccountsConnected SocialPlatformAccount[]
  socialPublicationsRequested SocialPublication[]    @relation("SocialPublicationRequester")
  researcherApplications ResearcherApplication[] @relation("ResearcherApplicant")
  reviewedResearcherApplications ResearcherApplication[] @relation("ResearcherApplicationReviewer")

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  phone              String?
  preferredLanguage  String            @default("en")
  occupation         String?
  bio                String?
  expertise          String[]          @default([])
  researchInterests  String[]          @default([])
  education          String?
  institution        String?
  locationDistrict   String?
  locationCountry    String            @default("Bangladesh")
  profileVisibility  ProfileVisibility @default(PUBLIC)
  contactVisibility  ProfileVisibility @default(PRIVATE)
  linksVisibility    ProfileVisibility @default(PUBLIC)
  avatarUrl          String?
  avatarKey          String?
  // ── Gamification ────────────────────────────────────────────────────────
  earnedBadges       String[]          @default([])
  contributionPoints Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSocialLink {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model ResearcherApplication {
  id               String                        @id @default(cuid())
  userId           String
  status           ResearcherApplicationStatus   @default(PENDING)
  reviewerId       String?
  reviewerNote     String?                       @db.Text
  reviewedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  user     User  @relation("ResearcherApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ResearcherApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  deviceId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Short-lived one-time code issued after Google OAuth succeeds.
// The Next.js callback page redeems it for a real access+refresh pair.
// TTL is 30 seconds — exchange codes are deleted daily by the cleanup cron.
model OAuthExchangeCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  description String?
  website     String?
  country     String           @default("Bangladesh")
  isVerified  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  providers           Provider[]
  restorationProjects RestorationProject[]
  memberships         OrganizationMembership[]
}

model OrganizationMembership {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

// ─── Providers ────────────────────────────────────────────────────────────────

model Provider {
  id             String        @id @default(cuid())
  name           String
  type           ProviderType
  country        String        @default("Bangladesh")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  datasets      Dataset[]
  ingestionJobs IngestionJob[]
}

// ─── Geography ────────────────────────────────────────────────────────────────

model Division {
  id       String  @id @default(cuid())
  name     String  @unique
  bnName   String?
  slug     String?
  pcode    String? @unique
  lat      Float?
  lng      Float?
  areaSqKm Float?
  url      String?

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  districts District[]
}

model District {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  slug       String?
  pcode      String?  @unique
  lat        Float?
  lng        Float?
  geom       Unsupported("geography(Point, 4326)")? // PostGIS generated column — set by migration
  centerLat  Float?
  centerLng  Float?
  areaSqKm   Float?
  url        String?
  boundary   Json?
  isCoastal  Boolean  @default(false)
  coastLat   Float?
  coastLng   Float?
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  upazilas            Upazila[]
  reports             CitizenReport[]
  alerts              Alert[]
  alertAreas          AlertArea[]
  observations        Observation[]
  restorationProjects RestorationProject[]
  occurrences         Occurrence[]
  alertSubscriptions  AlertSubscription[]

  currentWeatherReadings     CurrentWeatherReading[]
  hourlyWeatherForecasts     HourlyWeatherForecast[]
  dailyWeatherForecasts      DailyWeatherForecast[]
  airQualityReadings         HourlyAirQuality[]
  satelliteRadiationReadings SatelliteRadiationReading[]
  marineForecasts            MarineForecast[]
  waterLevelStations         WaterLevelStation[]
  communityPosts             CommunityPost[]
  socialPostDrafts           SocialPostDraft[]
  industrialFacilities       IndustrialFacility[]
  companiesHQ                Company[]

  @@unique([name, divisionId])
  @@index([divisionId])
}

model Upazila {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  slug       String?
  pcode      String?  @unique
  lat        Float?
  lng        Float?
  areaSqKm   Float?
  url        String?
  isThana    Boolean  @default(false)
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  unions               Union[]
  waterBodies          WaterBodyUpazila[]
  waterLevelStations   WaterLevelStation[]
  reports              CitizenReport[]
  alertAreas           AlertArea[]
  observations         Observation[]
  restorationProjects  RestorationProject[]
  industrialFacilities IndustrialFacility[]

  @@unique([name, districtId])
  @@index([districtId])
}

// ─── Water bodies ────────────────────────────────────────────────────────────

model WaterBody {
  id                     String            @id @default(cuid())
  code                   String            @unique
  slug                   String            @unique
  nameEn                 String
  nameBn                 String?
  hydrologicalClass      HydrologicalClass
  waterBodyType          WaterBodyType
  waterBodySubtype       String?
  latitude               Float
  longitude              Float
  transboundaryFlag      Boolean           @default(false)
  transboundaryCountries String?

  upazilas      WaterBodyUpazila[]
  loticDetails  LoticWaterBodyDetails?
  lenticDetails LenticWaterBodyDetails?
  stations      WaterBodyStation[]

  @@index([hydrologicalClass])
  @@index([waterBodyType])
}

model WaterBodyUpazila {
  waterBodyId String
  upazilaId   String

  waterBody WaterBody @relation(fields: [waterBodyId], references: [id], onDelete: Cascade)
  upazila   Upazila   @relation(fields: [upazilaId], references: [id], onDelete: Cascade)

  @@id([waterBodyId, upazilaId])
  @@index([upazilaId])
}

model LoticWaterBodyDetails {
  waterBodyId                        String  @id
  lengthKmBd                         Float?
  averageWidthM                      String?
  maxDepthM                          Float?
  meanDischargeM3s                   Float?
  hydrologicalOrigin                 String?
  outfallTo                          String?
  flowRegime                         String?
  divisionsTraversed                 String?
  districtsTraversed                 String?
  bwdbGaugingStations                String?
  banglapediaMatchName               String?
  banglapediaLengthKm                Float?
  banglapediaAreaCoveredOldDistricts String?
  banglapediaSource                  String?

  waterBody WaterBody @relation(fields: [waterBodyId], references: [id], onDelete: Cascade)
}

model LenticWaterBodyDetails {
  waterBodyId     String  @id
  areaMonsoonSqKm Float?
  areaDrySqKm     Float?
  waterVolumeEst  String?
  seasonality     String?

  waterBody WaterBody @relation(fields: [waterBodyId], references: [id], onDelete: Cascade)
}

model WaterLevelStation {
  id          String  @id @default(cuid())
  serial      Int
  stationCode String  @unique
  name        String
  riverName   String
  tidalStatus String?
  districtId  String?
  upazilaId   String?
  latitude    Float
  longitude   Float

  // Gauge thresholds (metres above datum). Null means threshold not yet configured.
  dangerLevel  Float?
  warningLevel Float?
  normalLevel  Float?

  district    District? @relation(fields: [districtId], references: [id])
  upazila     Upazila?  @relation(fields: [upazilaId], references: [id])
  waterBodies           WaterBodyStation[]
  stationFloodForecasts StationFloodForecast[]
  readings              WaterLevelReading[]

  @@unique([serial])
  @@index([riverName])
  @@index([districtId])
  @@index([upazilaId])
}

model WaterBodyStation {
  waterBodyId String
  stationId   String

  waterBody WaterBody         @relation(fields: [waterBodyId], references: [id], onDelete: Cascade)
  station   WaterLevelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([waterBodyId, stationId])
  @@index([stationId])
}

model Union {
  id        String  @id @default(cuid())
  name      String
  bnName    String?
  slug      String?
  pcode     String? @unique
  lat       Float?
  lng       Float?
  url       String?
  isCoastal Boolean @default(false)
  upazilaId String
  upazila   Upazila @relation(fields: [upazilaId], references: [id])

  // 30-day rolling climate averages (fetched directly from OpenMeteo at union lat/lng)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  dailyClimate         UnionDailyClimate[]
  reports              CitizenReport[]
  alertAreas           AlertArea[]
  observations         Observation[]
  restorationProjects  RestorationProject[]
  industrialFacilities IndustrialFacility[]

  @@unique([name, upazilaId])
  @@index([upazilaId])
}

// Daily climate history per union — used to compute 30-day rolling averages
model UnionDailyClimate {
  id            String   @id @default(cuid())
  unionId       String
  union         Union    @relation(fields: [unionId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  avgTemp       Float?
  minTemp       Float?
  maxTemp       Float?
  avgHumidity   Float?
  totalPrecip   Float?
  avgWindSpeed  Float?
  maxWindSpeed  Float?
  avgCloudCover Float?
  avgPm25       Float?
  avgPm10       Float?
  avgUvIndex    Float?
  avgOzone      Float?
  fetchedAt     DateTime @default(now())

  @@unique([unionId, date])
  @@index([unionId])
  @@index([date])
}

// ─── Datasets ─────────────────────────────────────────────────────────────────

model Dataset {
  id           String              @id @default(cuid())
  name         String
  category     DatasetCategory
  accessPolicy DatasetAccessPolicy @default(PUBLIC)
  source       String
  providerId   String?
  provider     Provider?           @relation(fields: [providerId], references: [id])
  description  String?
  recordCount  Int?
  lastSyncedAt DateTime?
  isPublished  Boolean             @default(true)

  // Metadata fields (Gap 5)
  license       String?  // SPDX identifier or free text, e.g. "CC-BY-4.0", "ODbL-1.0"
  refreshCron   String?  // cron expression for update cadence, e.g. "0 */15 * * * *"
  version       String?  // current schema/data version, e.g. "1.0.0"
  spatialExtent String?  // geographic coverage description, e.g. "All 64 Bangladesh districts"

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  accessRequests DatasetAccessRequest[]
  versions       DatasetVersion[]

  @@index([providerId])
  @@index([category])
  @@index([accessPolicy])
}

model DatasetAccessRequest {
  id          String                     @id @default(cuid())
  datasetId   String
  dataset     Dataset                    @relation(fields: [datasetId], references: [id])
  userId      String
  user        User                       @relation("DatasetAccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      DatasetAccessRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                      @relation("DatasetAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([datasetId, userId])
}

// Immutable version history for a dataset — published when schema or data changes.
model DatasetVersion {
  id            String   @id @default(cuid())
  datasetId     String
  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  version       String   // e.g. "1.2.0" — matches Dataset.version at time of publish
  notes         String?  // changelog / what changed
  publishedById String?
  publishedBy   User?    @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now())

  @@index([datasetId])
  @@index([publishedAt])
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model CitizenReport {
  id          String         @id @default(cuid())
  title       String
  description String
  category    ReportCategory @default(OTHER)
  status      ReportStatus   @default(SUBMITTED)
  summary     String?
  reporterId  String?
  reporter    User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  districtId  String?
  district    District?      @relation(fields: [districtId], references: [id])
  upazilaId   String?
  upazila     Upazila?       @relation(fields: [upazilaId], references: [id])
  unionId     String?
  union       Union?         @relation(fields: [unionId], references: [id])
  facilityId  String?
  facility    IndustrialFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  lat         Float?
  lng         Float?
  geom        Unsupported("geography(Point, 4326)")? // PostGIS generated column — set by migration
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  statusHistory ReportStatusEvent[]
  comments      ReportComment[]
  media         ReportMedia[]

  @@index([reporterId])
  @@index([status])
  @@index([category])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
  @@index([facilityId])
  @@index([createdAt])
}

model ReportStatusEvent {
  id        String        @id @default(cuid())
  reportId  String
  report    CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    ReportStatus
  note      String?
  createdAt DateTime      @default(now())

  @@index([reportId])
}

model ReportComment {
  id         String        @id @default(cuid())
  reportId   String
  report     CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String        @db.Text
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([reportId])
  @@index([authorId])
}

model ReportMedia {
  id           String        @id @default(cuid())
  reportId     String
  report       CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  url          String
  mimeType     String?
  fileSize     Int?
  caption      String?
  createdAt    DateTime      @default(now())

  @@index([reportId])
}

// ─── Observations ─────────────────────────────────────────────────────────────

model Observation {
  id          String                @id @default(cuid())
  category    ObservationCategory
  trustLevel  ObservationTrustLevel @default(UNVERIFIED)
  description String
  observerId  String?
  observer    User?                 @relation(fields: [observerId], references: [id], onDelete: SetNull)
  districtId  String?
  district    District?             @relation(fields: [districtId], references: [id])
  upazilaId   String?
  upazila     Upazila?              @relation(fields: [upazilaId], references: [id])
  unionId     String?
  union       Union?                @relation(fields: [unionId], references: [id])
  lat         Float?
  lng         Float?
  geom        Unsupported("geography(Point, 4326)")? // PostGIS generated column — set by migration
  species     String?
  observedAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  measurements ObservationMeasurement[]

  @@index([observerId])
  @@index([category])
  @@index([trustLevel])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
}

model ObservationMeasurement {
  id             String               @id @default(cuid())
  observationId  String
  observation    Observation          @relation(fields: [observationId], references: [id], onDelete: Cascade)
  parameter      MeasurementParameter
  value          Float
  unit           MeasurementUnit
  method         String?              // e.g. "Hach HQ30d field meter", "visual estimate"
  detectionLimit Float?               // minimum detectable value for lab results
  qualityFlag    QualityFlag          @default(GOOD)
  notes          String?
  recordedAt     DateTime             @default(now())

  @@index([observationId])
  @@index([parameter])
}

// ─── Restoration Projects ──────────────────────────────────────────────────────

model RestorationProject {
  id             String              @id @default(cuid())
  title          String
  description    String
  category       RestorationCategory
  status         ProjectStatus       @default(PLANNED)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  districtId     String?
  district       District?           @relation(fields: [districtId], references: [id])
  upazilaId      String?
  upazila        Upazila?            @relation(fields: [upazilaId], references: [id])
  unionId        String?
  union          Union?              @relation(fields: [unionId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  impactSummary  String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  participants RestorationParticipant[]
  targets      ProjectTarget[]
  activities   ProjectActivity[]

  @@index([category])
  @@index([status])
  @@index([organizationId])
  @@index([createdById])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
}

model RestorationParticipant {
  id        String             @id @default(cuid())
  projectId String
  project   RestorationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime           @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ─── Industrial Facilities ────────────────────────────────────────────────────

model Company {
  id                    String      @id @default(cuid())
  name                  String      @unique
  bnName                String?
  description           String?
  companyType           CompanyType
  registrationNumber    String?
  establishedYear       Int?
  employeeCount         Int?
  website               String?
  contactEmail          String?
  contactPhone          String?
  isActive              Boolean     @default(true)

  headquarterDistrictId String?
  headquarterDistrict   District?   @relation(fields: [headquarterDistrictId], references: [id])

  parentCompanyId String?
  parentCompany   Company?  @relation("CompanySubsidiaries", fields: [parentCompanyId], references: [id])
  subsidiaries    Company[] @relation("CompanySubsidiaries")

  facilities IndustrialFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyType])
  @@index([headquarterDistrictId])
  @@index([parentCompanyId])
}

model IndustrialFacility {
  id               String           @id @default(cuid())
  name             String
  bnName           String?
  description      String?
  facilityType     FacilityType
  complianceStatus ComplianceStatus @default(UNKNOWN)
  isActive         Boolean          @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  establishedYear    Int?
  productionCapacity String?
  landArea           Float?
  etpInstalled       Boolean @default(false)
  etpCapacity        Float?

  lat       Float?
  lng       Float?
  districtId String
  district   District  @relation(fields: [districtId], references: [id])
  upazilaId  String?
  upazila    Upazila?  @relation(fields: [upazilaId], references: [id])
  unionId    String?
  union      Union?    @relation(fields: [unionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports CitizenReport[]

  @@index([facilityType])
  @@index([complianceStatus])
  @@index([companyId])
  @@index([districtId])
  @@index([upazilaId])
  @@index([isActive])
}

// Measurable goals set for a restoration project.
model ProjectTarget {
  id          String                  @id @default(cuid())
  projectId   String
  project     RestorationProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metric      RestorationTargetMetric
  targetValue Float
  unit        String?
  deadline    DateTime?
  createdAt   DateTime                @default(now())

  measurements ProjectMetric[]

  @@index([projectId])
}

// Work log entries — what actually happened in the field.
model ProjectActivity {
  id              String             @id @default(cuid())
  projectId       String
  project         RestorationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String
  activityDate    DateTime
  volunteersCount Int?
  areaAffectedHa  Float?
  recordedById    String?
  recordedBy      User?              @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([projectId])
  @@index([activityDate])
}

// Measured outcomes recorded against a specific target.
model ProjectMetric {
  id           String        @id @default(cuid())
  targetId     String
  target       ProjectTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  measuredAt   DateTime
  value        Float
  notes        String?
  measuredById String?
  measuredBy   User?         @relation(fields: [measuredById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([targetId])
  @@index([measuredAt])
}

// ─── Biodiversity (GBIF) ───────────────────────────────────────────────────────

model Species {
  id             String   @id @default(cuid())
  gbifKey        Int      @unique
  canonicalName  String
  vernacularName String?
  kingdom        String?
  phylum         String?
  class          String?
  order          String?
  family         String?
  genus          String?
  iucnStatus     String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  occurrences Occurrence[]

  @@index([canonicalName])
}

model Occurrence {
  id                String    @id @default(cuid())
  gbifOccurrenceKey BigInt    @unique
  speciesId         String
  species           Species   @relation(fields: [speciesId], references: [id])
  districtId        String?
  district          District? @relation(fields: [districtId], references: [id])
  lat               Float
  lng               Float
  observedAt        DateTime?
  recordedBy        String?
  basisOfRecord     String?
  createdAt         DateTime  @default(now())

  @@index([speciesId])
  @@index([districtId])
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

model Alert {
  id           String        @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity @default(INFO)
  status       AlertStatus   @default(DRAFT)
  alertType    AlertType?
  instructions String?
  // districtId kept for backward-compat with notification fan-out.
  // Canonical multi-area scope lives in AlertArea[].
  districtId   String?
  district     District?     @relation(fields: [districtId], references: [id])
  issuedAt     DateTime      @default(now())
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  areas      AlertArea[]
  deliveries NotificationDelivery[]

  @@index([status])
  @@index([severity])
  @@index([alertType])
}

model AlertArea {
  id         String    @id @default(cuid())
  alertId    String
  alert      Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  upazilaId  String?
  upazila    Upazila?  @relation(fields: [upazilaId], references: [id])
  unionId    String?
  union      Union?    @relation(fields: [unionId], references: [id])

  @@index([alertId])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model AlertSubscription {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId  String?
  // null = nationwide subscription (receives alerts for any district)
  district    District?           @relation(fields: [districtId], references: [id])
  channel     NotificationChannel @default(EMAIL)
  // Minimum alert severity to trigger delivery. A subscriber with minSeverity
  // WARNING receives WARNING and EMERGENCY alerts only.
  minSeverity AlertSeverity       @default(INFO)
  createdAt   DateTime            @default(now())

  // No @@unique here: Postgres treats NULL != NULL in unique indexes, so
  // @@unique([userId, districtId, channel]) would allow duplicate global
  // (districtId IS NULL) subscriptions per user. Uniqueness is enforced in
  // NotificationsService.subscribe() instead.
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([districtId])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  // Cascade: deleting a subscription removes its delivery history.
  subscription   AlertSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  alertId        String
  alert          Alert               @relation(fields: [alertId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  // Address captured at send time — preserved even if the user later changes email.
  address        String
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  @@index([alertId])
  @@index([userId])
  @@index([status])
}

// ─── Ingestion ────────────────────────────────────────────────────────────────

model IngestionJob {
  id         String          @id @default(cuid())
  providerId String
  provider   Provider        @relation(fields: [providerId], references: [id])
  status     IngestionStatus @default(QUEUED)
  startedAt  DateTime?
  endedAt    DateTime?
  errorMsg   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([providerId])
  @@index([status])
}

// ─── Flood (OpenMeteo / GloFAS) ─────────────────────────────────────────────
// Daily simulated river discharge fetched at each BWDB water level station's
// exact coordinates — more accurate than district centroids because GloFAS
// snaps to the nearest river grid cell and stations are already on rivers.

model StationFloodForecast {
  id                   String            @id @default(cuid())
  stationId            String
  station              WaterLevelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  lat                  Float
  lng                  Float
  forecastDate         DateTime          @db.Date
  riverDischarge       Float?
  riverDischargeMean   Float?
  riverDischargeMedian Float?
  riverDischargeMax    Float?
  riverDischargeMin    Float?
  riverDischargeP25    Float?
  riverDischargeP75    Float?
  riverDischargeP10    Float?
  riverDischargeP90    Float?
  ingestionJobId       String?           // IngestionJob that last wrote this row
  createdAt            DateTime          @default(now())

  @@unique([stationId, forecastDate])
  @@index([stationId])
  @@index([forecastDate])
  @@index([ingestionJobId])
}

// Timestamped gauge readings from BWDB stations (observed water level).
// Upserted per (stationId, readingAt) — same station can be updated in-place
// if re-ingested with corrected values.
model WaterLevelReading {
  id             String            @id @default(cuid())
  stationId      String
  station        WaterLevelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  readingAt      DateTime          // UTC timestamp of the observation
  waterLevel     Float             // metres above datum
  discharge      Float?            // m³/s, if available from the source
  trend          WaterLevelTrend   @default(STEADY)
  ingestionJobId String?           // IngestionJob that last wrote this row
  createdAt      DateTime          @default(now())

  @@unique([stationId, readingAt])
  @@index([stationId])
  @@index([readingAt])
  @@index([ingestionJobId])
}

// ─── Marine Weather (OpenMeteo Marine API) ───────────────────────────────────
// Daily wave, swell, and wind-wave forecasts for each district's nearest marine grid cell.
// Wave heights in metres; directions in degrees; periods in seconds.
// Inland districts will have no rows — the marine API only resolves sea grid cells.

model MarineForecast {
  id                         String   @id @default(cuid())
  districtId                 String
  district                   District @relation(fields: [districtId], references: [id])
  lat                        Float
  lng                        Float
  forecastDate               DateTime @db.Date
  waveHeightMax              Float?
  waveDirectionDominant      Float?
  wavePeriodMax              Float?
  windWaveHeightMax          Float?
  windWaveDirectionDominant  Float?
  windWavePeriodMax          Float?
  windWavePeakPeriodMax      Float?
  swellWaveHeightMax         Float?
  swellWaveDirectionDominant Float?
  swellWavePeriodMax         Float?
  swellWavePeakPeriodMax     Float?
  seaSurfaceTemp             Float?
  ingestionJobId             String?  // IngestionJob that last wrote this row
  createdAt                  DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
  @@index([forecastDate])
  @@index([ingestionJobId])
}

// ─── Satellite Radiation (OpenMeteo Satellite API) ───────────────────────────
// Daily solar radiation totals per district. shortwaveRadiationSum in MJ/m²,
// aggregated from native 10-minute W/m² samples (Σ W/m² × step_s / 1,000,000).
// sunshine_duration and daylight_duration are not available from the satellite
// archive API and are intentionally omitted.

model SatelliteRadiationReading {
  id                    String   @id @default(cuid())
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  lat                   Float
  lng                   Float
  readingDate           DateTime @db.Date
  shortwaveRadiationSum Float?
  ingestionJobId        String?  // IngestionJob that last wrote this row
  createdAt             DateTime @default(now())

  @@unique([districtId, readingDate])
  @@index([districtId])
  @@index([readingDate])
  @@index([ingestionJobId])
}

// ─── Weather ──────────────────────────────────────────────────────────────────
// Keyed by district (not raw lat/lng) since every fetch targets a known district;
// lat/lng are kept for provenance only.

model CurrentWeatherReading {
  id                  String   @id @default(cuid())
  districtId          String
  district            District @relation(fields: [districtId], references: [id])
  lat                 Float
  lng                 Float
  readingTime         DateTime
  temperature2m       Float?
  relativeHumidity2m  Int?
  apparentTemperature Float?
  windSpeed10m        Float?
  windDirection10m    Int?
  precipitation       Float?
  weatherCode         Int?
  cloudCover          Int?
  isDay               Boolean?
  windGusts10m        Float?
  surfacePressure     Float?
  ingestionJobId      String?  // IngestionJob that created this row
  createdAt           DateTime @default(now())

  @@unique([districtId, readingTime])
  @@index([districtId])
  @@index([ingestionJobId])
}

model HourlyWeatherForecast {
  id                       String   @id @default(cuid())
  districtId               String
  district                 District @relation(fields: [districtId], references: [id])
  lat                      Float
  lng                      Float
  forecastTime             DateTime
  temperature2m            Float?
  relativeHumidity2m       Int?
  apparentTemperature      Float?
  precipitationProbability Int?
  precipitation            Float?
  weatherCode              Int?
  windSpeed10m             Float?
  windDirection10m         Int?
  cloudCover               Int?
  windGusts10m             Float?
  ingestionJobId           String?  // IngestionJob that created this row
  createdAt                DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
  @@index([ingestionJobId])
}

model DailyWeatherForecast {
  id                          String    @id @default(cuid())
  districtId                  String
  district                    District  @relation(fields: [districtId], references: [id])
  lat                         Float
  lng                         Float
  forecastDate                DateTime  @db.Date
  weatherCode                 Int?
  temperature2mMax            Float?
  temperature2mMin            Float?
  apparentTemperatureMax      Float?
  apparentTemperatureMin      Float?
  precipitationSum            Float?
  precipitationProbabilityMax Int?
  windSpeed10mMax             Float?
  uvIndexMax                  Float?
  sunrise                     DateTime?
  sunset                      DateTime?
  ingestionJobId              String?   // IngestionJob that created this row
  createdAt                   DateTime  @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
  @@index([ingestionJobId])
}

model HourlyAirQuality {
  id              String   @id @default(cuid())
  districtId      String
  district        District @relation(fields: [districtId], references: [id])
  lat             Float
  lng             Float
  forecastTime    DateTime
  pm10            Float?
  pm25            Float?
  carbonMonoxide  Float?
  nitrogenDioxide Float?
  sulphurDioxide  Float?
  ozone           Float?
  uvIndex         Float?
  ingestionJobId  String?  // IngestionJob that created this row
  createdAt       DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
  @@index([ingestionJobId])
}

// ─── Emissions ────────────────────────────────────────────────────────────────
// National-level GHG readings ingested from the World Bank Climate Change API.
// One row per (year, indicatorCode); values are in Mt CO2e.

model NationalEmissionReading {
  id            String   @id @default(cuid())
  year          Int
  indicatorCode String
  indicatorName String
  value         Float?
  unit          String   @default("Mt CO2e")
  ingestionJobId String? // IngestionJob that last wrote this row
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([year, indicatorCode])
  @@index([indicatorCode])
  @@index([year])
}

// ─── Permissions ──────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

// ─── Social content ─────────────────────────────────────────────────────────

model SocialPostDraft {
  id                String            @id @default(cuid())
  type              SocialContentType
  status            SocialDraftStatus @default(DRAFT)
  format            SocialCardFormat  @default(PORTRAIT_4_5)
  locale            String            @default("en")
  headline          String
  summary           String?           @db.Text
  caption           String?           @db.Text
  disclaimer        String?
  templateKey       String            @default("delta-signal-v1")
  districtId        String?
  sourceId          String?
  sourceLabel       String
  sourceObservedAt  DateTime?
  sourceSnapshot    Json
  createdById       String
  updatedById       String?
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedNote     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  district          District?         @relation(fields: [districtId], references: [id])
  createdBy         User              @relation("SocialDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?             @relation("SocialDraftUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy        User?             @relation("SocialDraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  renderedAssets    SocialRenderedAsset[]
  publications      SocialPublication[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([districtId])
}

model SocialRenderedAsset {
  id            String            @id @default(cuid())
  draftId       String
  format        SocialCardFormat
  width         Int
  height        Int
  storageKey    String            @unique
  publicUrl     String
  contentHash   String
  renderVersion String
  createdAt     DateTime          @default(now())

  draft         SocialPostDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  publications  SocialPublication[]

  @@index([draftId, createdAt])
}

model SocialPlatformAccount {
  id                String                       @id @default(cuid())
  platform          SocialPlatform
  externalAccountId String
  displayName       String
  accessTokenCipher String                       @db.Text
  status            SocialPlatformAccountStatus  @default(ACTIVE)
  connectedById     String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  connectedBy       User                         @relation(fields: [connectedById], references: [id], onDelete: Restrict)
  publications      SocialPublication[]

  @@unique([platform, externalAccountId])
}

model SocialPublication {
  id                String                   @id @default(cuid())
  draftId           String
  platformAccountId String
  renderedAssetId   String
  status            SocialPublicationStatus  @default(PENDING)
  externalPostId    String?
  externalUrl       String?
  error             String?
  requestedById     String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  draft             SocialPostDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  platformAccount   SocialPlatformAccount    @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  renderedAsset     SocialRenderedAsset      @relation(fields: [renderedAssetId], references: [id], onDelete: Restrict)
  requestedBy       User                     @relation("SocialPublicationRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([draftId])
  @@index([platformAccountId, createdAt])
}

// ─── Community ────────────────────────────────────────────────────────────────

model CommunityPost {
  id         String    @id @default(cuid())
  title      String
  body       String    @db.Text
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments PostComment[]
  poll     Poll?

  @@index([authorId])
  @@index([districtId])
  @@index([createdAt])
}

model PostComment {
  id        String        @id @default(cuid())
  body      String        @db.Text
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([authorId])
}

model Poll {
  id        String        @id @default(cuid())
  postId    String        @unique
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String
  endsAt    DateTime?
  createdAt DateTime      @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
}
