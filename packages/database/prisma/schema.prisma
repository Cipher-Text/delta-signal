  RIVERBANK_PROTECTION
  MANGROVE
  WASTE_MANAGEMENT
  OTHER
}

enum ObservationCategory {
  BIODIVERSITY
  WATER_QUALITY
  AIR_QUALITY
  LAND_USE
  RESTORATION
}

enum ObservationTrustLevel {
